                    backgroundColor: ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    title: { display: true, text: 'Сравнение точности методов детекции', font: { size: 16, weight: 'bold' } },
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: false, min: 85, max: 100, title: { display: true, text: 'Точность, %' } }
                }
            }
        });

        // Q&A Toggle
        function toggleAnswer(element) {
            const answer = element.nextElementSibling;
            const isActive = answer.classList.contains('active');
            document.querySelectorAll('.qa-answer').forEach(a => a.classList.remove('active'));
            if (!isActive) answer.classList.add('active');
        }

        // Smooth Scroll & Animations
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('section').forEach(sec => {
            sec.style.opacity = '0';
            sec.style.transform = 'translateY(20px)';
            sec.style.transition = 'all 0.6s ease-out';
            observer.observe(sec);
        });
    </script>
